# Django Secret Key
SECRET_KEY=django-insecure-dev-key-change-in-production

# Debug Mode
DEBUG=True

# Allowed Hosts
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app,ai-recipe-2wpn.vercel.app,*

# CORS & CSRF Allowed Origins
CORS_ALLOWED_ORIGINS=https://ai-recipe-eta.vercel.app,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://ai-recipe-eta.vercel.app,https://ai-recipe-2wpn.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# HuggingFace API Key for Recipe Generation
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# MongoDB Database Configuration
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=recipeai_db
MONGODB_TIMEOUT_MS=3000

# Razorpay Payment Gateway (from Razorpay Dashboard: https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

