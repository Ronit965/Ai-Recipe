# Frontend Environment Variables
VITE_API_URL=https://ai-recipe-2wpn.vercel.app

# Google OAuth 2.0 Client ID (from Google Cloud Console: https://console.cloud.google.com/apis/credentials)
# When provided, "Continue with Google" will open Google's native account chooser showing all accounts on your device.
VITE_GOOGLE_CLIENT_ID=

# GitHub OAuth Client ID (from GitHub: https://github.com/settings/developers)
VITE_GITHUB_CLIENT_ID=

# Razorpay Key ID (from Razorpay Dashboard: https://dashboard.razorpay.com/app/keys)
VITE_RAZORPAY_KEY_ID=

